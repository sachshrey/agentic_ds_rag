# Copy this to .env and fill in your keys

# OpenAI — required for high-stakes nodes (task detection, critic, report)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# LangSmith — optional but strongly recommended for debugging
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=agentic-ds-rag
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Ollama — runs locally, no key needed
# Make sure Ollama is running: `ollama serve`
OLLAMA_BASE_URL=http://localhost:11434
# Current code path uses llama3.2:3b in utils/llm.py
OLLAMA_MODEL=llama3.2:3b

# Paths — change only if needed
OUTPUT_DIR=outputs
CACHE_DIR=cache
MLFLOW_TRACKING_URI=mlruns

# Embedding device: cpu (default, works everywhere), mps (Mac M-series), cuda (NVIDIA)
EMBED_DEVICE=cpu
